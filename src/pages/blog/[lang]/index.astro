---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import TotalViews from '../../../components/TotalViews.astro';
import { getLangStaticPaths, getSortedPosts } from '../../../lib/posts';
import { htmlLang, type Locale } from '../../../lib/i18n';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Locale;
const posts = await getSortedPosts('general', lang);
const slugs = posts.map((post) => post.slug);
---

<BaseLayout section="general" lang={htmlLang[lang]} description="Articles and thoughts by Chung-Chia (Tim) Kuo">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <div class="flex items-start justify-between gap-6 mb-12">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2 dark:text-gray-100">Blog</h1>
        <p class="text-gray-500 dark:text-gray-400">從明天起，關心糧食和蔬菜</p>
      </div>
      {/* Top-right corner on desktop, bottom of the page on mobile. */}
      <TotalViews slugs={slugs} class="hidden sm:flex shrink-0 mt-2" />
    </div>
    <PostList posts={posts} basePath={`/blog/${lang}`} />
    <TotalViews slugs={slugs} class="flex sm:hidden justify-center mt-16" />
  </div>
</BaseLayout>
