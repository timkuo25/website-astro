---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostNav from '../../../components/PostNav.astro';
import UntranslatedNotice from '../../../components/UntranslatedNotice.astro';
import ViewCount from '../../../components/ViewCount.astro';
import { getPostStaticPaths, type PostPageProps } from '../../../lib/posts';
import { htmlLang, type Locale } from '../../../lib/i18n';

export const getStaticPaths = () => getPostStaticPaths('general');

const lang = Astro.params.lang as Locale;
const { post, prev, next } = Astro.props as PostPageProps;
const { Content } = await render(post.entry);
const basePath = `/blog/${lang}`;
---

<BaseLayout section="general" lang={htmlLang[lang]} title={`${post.title} — TCK`}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <a
      href={basePath}
      class="text-sm text-gray-400 hover:text-gray-700 transition-colors mb-10 inline-block dark:text-gray-500 dark:hover:text-gray-300"
    >
      ← Back to Blog
    </a>

    <article>
      <header class="mb-10">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">{post.title}</h1>
        <ViewCount slug={post.slug} class="mt-4 text-xs text-gray-400 tracking-wide dark:text-gray-500" />
      </header>

      {!post.translated && <UntranslatedNotice />}

      <div class="prose"><Content /></div>
    </article>

    <PostNav prev={prev} next={next} basePath={basePath} />
  </div>
</BaseLayout>
