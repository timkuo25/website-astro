---
import { ArrowLeft, ArrowUp } from '@lucide/astro';
import TechBlogLayout from '../../../../layouts/TechBlogLayout.astro';
import PostList from '../../../../components/PostList.astro';
import RandomQuote from '../../../../components/RandomQuote.astro';
import { getLangStaticPaths, getSortedPosts } from '../../../../lib/posts';
import { categories } from '../../../../lib/categories';
import type { Locale } from '../../../../lib/i18n';

export const getStaticPaths = getLangStaticPaths;

const lang = Astro.params.lang as Locale;
const posts = await getSortedPosts('tech', lang);

// The sidebar sits on the left on desktop, but moves into the header's menu
// (top right) on mobile, so each gets its own wording and arrow.
const promptText: Record<Locale, { desktop: string; mobile: string }> = {
  zh: { desktop: '請選擇一個類別開始看文章', mobile: '請從右上角選單選擇一個類別開始看文章' },
  en: { desktop: 'Pick a category to start reading', mobile: 'Pick a category from the menu to start reading' },
  ja: {
    desktop: 'カテゴリを選んで記事を読み始めましょう',
    mobile: '右上のメニューからカテゴリを選んで記事を読み始めましょう',
  },
};
const filters = [...categories, 'all'];
---

<TechBlogLayout lang={lang} posts={posts} title="Blog — TCK" description="Technical articles by TCK">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2 dark:text-gray-100">Blog</h1>
  <RandomQuote lang={lang} class="text-gray-500 mb-12 dark:text-gray-400" />

  {/* Shown until a category is picked. The script below swaps it for the
      filtered list; without JavaScript the full list shows instead. */}
  <div data-category-prompt class="text-gray-500 dark:text-gray-400">
    <p class="hidden sm:flex items-center gap-3">
      <ArrowLeft size={20} class="shrink-0 text-blue-500 dark:text-blue-400" aria-hidden="true" />
      {promptText[lang].desktop}
    </p>
    <div class="sm:hidden flex flex-col items-end gap-2 text-right">
      <ArrowUp size={20} class="mr-1 text-blue-500 dark:text-blue-400" aria-hidden="true" />
      <p>{promptText[lang].mobile}</p>
    </div>
  </div>

  <div data-category-posts data-categories={JSON.stringify(filters)} hidden>
    <PostList posts={posts} basePath={`/tech/blog/${lang}`} showTags />
  </div>

  {/* is:inline keeps Astro from hoisting this out of <noscript>. */}
  <noscript>
    <style is:inline>
      [data-category-prompt] { display: none; }
      [data-category-posts] { display: block !important; }
    </style>
  </noscript>
</TechBlogLayout>

<script>
  // Clicking a category in the sidebar (or the mobile menu) shows that
  // category's posts here. The choice lives in ?category= so a refresh, a
  // shared link or the sidebar's "All Articles" link (?category=all) restore it.
  // Re-run on every page load, since client-side navigation swaps the page
  // without re-running module scripts.
  document.addEventListener('astro:page-load', () => {
    const container = document.querySelector<HTMLElement>('[data-category-posts]');
    const prompt = document.querySelector<HTMLElement>('[data-category-prompt]');
    if (!container || !prompt) return;

    const filters = JSON.parse(container.dataset.categories!) as string[];
    const items = [...container.querySelectorAll<HTMLElement>('[data-post-categories]')];

    const show = (category: string | null) => {
      const valid = category !== null && filters.includes(category);
      prompt.hidden = valid;
      container.hidden = !valid;
      // Highlight the picked item in both the sidebar and the mobile menu.
      for (const details of document.querySelectorAll<HTMLElement>('details[data-category]')) {
        details.toggleAttribute('data-active', details.dataset.category === category);
      }
      for (const link of document.querySelectorAll('[data-all-articles]')) {
        link.toggleAttribute('data-active', category === 'all');
      }
      if (!valid || category === null) return;
      for (const item of items) {
        item.hidden = category !== 'all' && !item.dataset.postCategories!.split(' ').includes(category);
      }
    };

    show(new URLSearchParams(location.search).get('category'));

    for (const details of document.querySelectorAll<HTMLElement>('details[data-category]')) {
      details.querySelector('summary')?.addEventListener('click', () => {
        const category = details.dataset.category!;
        const url = new URL(location.href);
        url.searchParams.set('category', category);
        history.replaceState(history.state, '', url);
        show(category);
        // Picked from the mobile menu: close it so the list is visible.
        if (details.closest('#mobile-menu')) {
          document.querySelector<HTMLElement>('[data-mobile-menu-toggle][aria-expanded="true"]')?.click();
        }
      });
    }
  });
</script>
