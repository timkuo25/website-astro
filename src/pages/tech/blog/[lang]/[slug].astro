---
import { render } from 'astro:content';
import TechBlogLayout from '../../../../layouts/TechBlogLayout.astro';
import PostNav from '../../../../components/PostNav.astro';
import Tags from '../../../../components/Tags.astro';
import TableOfContents from '../../../../components/TableOfContents.astro';
import UntranslatedNotice from '../../../../components/UntranslatedNotice.astro';
import ViewCount from '../../../../components/ViewCount.astro';
import { estimateReadingMinutes, getPostStaticPaths, type PostPageProps } from '../../../../lib/posts';
import { categoryLabels } from '../../../../lib/categories';
import type { Locale } from '../../../../lib/i18n';

export const getStaticPaths = () => getPostStaticPaths('tech');

const lang = Astro.params.lang as Locale;
const { post, posts, prev, next } = Astro.props as PostPageProps;
const { Content, headings } = await render(post.entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const readingMinutes = estimateReadingMinutes(post.entry.body ?? '');
const basePath = `/tech/blog/${lang}`;
---

<TechBlogLayout lang={lang} posts={posts} currentSlug={post.slug} title={`${post.title} — TCK`}>
  <div class="flex gap-10">
    <div class="flex-1 min-w-0">
      <nav class="mb-6 text-sm text-gray-400 dark:text-gray-500" aria-label="Breadcrumb">
        <a href={basePath} class="hover:text-gray-700 dark:hover:text-gray-300">Blog</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-gray-600 dark:text-gray-300">{post.title}</span>
      </nav>

      <article>
        <header class="mb-10">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">{post.title}</h1>

          {
            post.categories.length > 0 && (
              <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
                Category: {post.categories.map((category) => categoryLabels[category]).join(', ')}
              </p>
            )
          }

          <Tags tags={post.tags} />

          <div class="flex items-center gap-2 mt-4 text-xs text-gray-400 tracking-wide dark:text-gray-500">
            <span>{readingMinutes} min read</span>
            <ViewCount slug={post.slug} class="before:content-['·'] before:mr-2" />
          </div>
        </header>

        {!post.translated && <UntranslatedNotice />}

        <div class="prose"><Content /></div>
      </article>

      <PostNav prev={prev} next={next} basePath={basePath} />
    </div>

    {
      toc.length > 0 && (
        <aside class="hidden lg:block w-52 shrink-0">
          <div class="sticky top-20">
            <TableOfContents headings={toc} title="Table of Contents" />
          </div>
        </aside>
      )
    }
  </div>
</TechBlogLayout>
