---
import { Mail } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GithubIcon from '../../components/GithubIcon.astro';
---

<BaseLayout section="tech" description="Chung-Chia (Tim) Kuo's technical blog and resume">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-12 sm:space-y-16">
    <section>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-black dark:text-white">嗨</h1>
      <p class="mt-2 text-sm text-gray-400 dark:text-gray-500">📍 Taipei, Taiwan</p>
      <div class="mt-6 flex items-center gap-4">
        <a
          href="mailto:timkuo860930@gmail.com"
          class="text-black hover:text-blue-500 transition-colors dark:text-white dark:hover:text-blue-400"
          aria-label="Email"
        >
          <Mail size={20} />
        </a>
        <a
          href="https://github.com/timkuo25"
          target="_blank"
          rel="noopener noreferrer"
          class="text-black hover:text-blue-500 transition-colors dark:text-white dark:hover:text-blue-400"
          aria-label="GitHub"
        >
          <GithubIcon size={20} />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
