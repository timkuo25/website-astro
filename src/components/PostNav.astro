---
import type { PostMeta } from '../lib/posts';

interface Props {
  prev: PostMeta | null;
  next: PostMeta | null;
  basePath: string;
}

const { prev, next, basePath } = Astro.props;
---

{
  (prev || next) && (
    <nav class="mt-16 pt-8 border-t border-gray-100 flex gap-4 text-sm dark:border-gray-800">
      <div class="flex-1">
        {prev && (
          <a href={`${basePath}/${prev.slug}`} class="group block">
            <span class="block text-gray-400 dark:text-gray-500">← Previous</span>
            <span class="block mt-1 text-gray-700 group-hover:text-gray-900 transition-colors dark:text-gray-300 dark:group-hover:text-gray-100">
              {prev.title}
            </span>
          </a>
        )}
      </div>
      <div class="flex-1 text-right">
        {next && (
          <a href={`${basePath}/${next.slug}`} class="group block">
            <span class="block text-gray-400 dark:text-gray-500">Next →</span>
            <span class="block mt-1 text-gray-700 group-hover:text-gray-900 transition-colors dark:text-gray-300 dark:group-hover:text-gray-100">
              {next.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  )
}
