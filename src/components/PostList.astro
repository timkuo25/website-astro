---
import type { PostMeta } from '../lib/posts';
import { untranslatedNotice } from '../lib/i18n';
import Tags from './Tags.astro';

interface Props {
  posts: PostMeta[];
  basePath: string;
  showTags?: boolean;
}

const { posts, basePath, showTags = false } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="text-gray-400 dark:text-gray-500">No posts yet. Check back soon.</p>
  ) : (
    <ul class="space-y-10">
      {posts.map((post) => (
        <li data-post-categories={post.categories.join(' ')}>
          <a href={`${basePath}/${post.slug}`} class="group block">
            <h2 class="text-lg font-semibold text-gray-900 group-hover:text-gray-600 transition-colors dark:text-gray-100 dark:group-hover:text-gray-400">
              {post.title}
            </h2>
            {!post.translated && <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{untranslatedNotice}</p>}
            {post.excerpt && (
              <p class="mt-2 text-sm text-gray-500 leading-relaxed dark:text-gray-400">{post.excerpt}</p>
            )}
            <span class="mt-3 inline-block text-xs text-gray-400 group-hover:text-gray-700 transition-colors dark:text-gray-500 dark:group-hover:text-gray-300">
              Read more →
            </span>
            {showTags && <Tags tags={post.tags} class="mt-3" />}
          </a>
        </li>
      ))}
    </ul>
  )
}
