---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = 'mt-4' } = Astro.props;
---

{
  tags.length > 0 && (
    <div class:list={['flex flex-wrap gap-2', className]}>
      {tags.map((tag) => (
        <span class="text-xs px-2 py-1 rounded-md bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
          {tag}
        </span>
      ))}
    </div>
  )
}
