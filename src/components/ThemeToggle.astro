---
import { Moon, Sun } from '@lucide/astro';
---

{/* Both icons are rendered; CSS picks one from the .dark class on <html>,
    so the button is correct on first paint without any client state. */}
<button
  type="button"
  data-theme-toggle
  aria-label="Toggle dark mode"
  class="text-gray-600 hover:text-gray-900 transition-colors dark:text-gray-400 dark:hover:text-gray-100"
>
  <Sun size={18} class="dark:hidden" />
  <Moon size={18} class="hidden dark:block" />
</button>

<script>
  // Delegated on document: module scripts run once, but the button is
  // replaced on every client-side navigation.
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-theme-toggle]')) return;
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
