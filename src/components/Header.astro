---
import { ChevronDown, Menu, X } from '@lucide/astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  homeHref: string;
  homeLabel?: string;
  links: { label: string; href: string }[];
  // Whether the page passed extra navigation (e.g. blog categories) for the
  // mobile menu through the "mobile-nav" slot.
  hasMobileNav?: boolean;
}

const { homeHref, homeLabel = 'Home', links, hasMobileNav = false } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white border-b border-blue-50 dark:bg-gray-950 dark:border-gray-800">
  <nav class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <a
      href={homeHref}
      class="font-semibold text-gray-900 hover:text-gray-600 transition-colors dark:text-gray-100 dark:hover:text-gray-300"
    >
      {homeLabel}
    </a>

    <div class="hidden sm:flex items-center gap-6 text-sm text-gray-600 dark:text-gray-400">
      {
        links.map((link) => (
          <a href={link.href} class="hover:text-gray-900 transition-colors dark:hover:text-gray-100">
            {link.label}
          </a>
        ))
      }
      <LanguageSwitcher />
      <ThemeToggle />
    </div>

    <div class="flex sm:hidden items-center gap-4">
      <ThemeToggle />
      <button
        type="button"
        data-mobile-menu-toggle
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="group text-gray-600 hover:text-gray-900 transition-colors dark:text-gray-400 dark:hover:text-gray-100"
      >
        <Menu size={22} class="group-aria-expanded:hidden" />
        <X size={22} class="hidden group-aria-expanded:block" />
      </button>
    </div>
  </nav>

  {/* Mobile-only dropdown. The header is replaced on every client-side
      navigation, so the menu always starts closed on the next page. */}
  <div
    id="mobile-menu"
    hidden
    class="sm:hidden absolute inset-x-0 top-full max-h-[calc(100dvh-3.5rem)] overflow-y-auto bg-white border-b border-blue-50 shadow-sm dark:bg-gray-950 dark:border-gray-800"
  >
    <div class="px-4 py-3 text-sm">
      <div class="flex justify-end empty:hidden pb-3 border-b border-gray-100 dark:border-gray-800"><LanguageSwitcher /></div>
      <ul class="divide-y divide-gray-100 dark:divide-gray-800">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block py-3 font-medium text-gray-700 hover:text-gray-900 transition-colors dark:text-gray-300 dark:hover:text-gray-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        {
          hasMobileNav && (
            <li>
              <details class="group/categories">
                <summary class="flex items-center justify-between py-3 font-medium text-gray-700 hover:text-gray-900 transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden dark:text-gray-300 dark:hover:text-gray-100">
                  <span>Categories</span>
                  <ChevronDown
                    size={16}
                    class="text-gray-400 transition-transform group-open/categories:rotate-180 dark:text-gray-500"
                  />
                </summary>
                <div class="pb-3 pl-3">
                  <slot name="mobile-nav" />
                </div>
              </details>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</header>

<script>
  // Delegated on document: module scripts run once, but the header is
  // replaced on every client-side navigation.
  function setOpen(open: boolean) {
    const button = document.querySelector('[data-mobile-menu-toggle]');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('[data-mobile-menu-toggle]')) {
      setOpen(document.getElementById('mobile-menu')?.hidden === true);
    } else if (!target.closest('#mobile-menu')) {
      setOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
